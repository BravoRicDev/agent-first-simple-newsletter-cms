# ─────────────────────────────────────────────────────────────────────────────
# .env.cluster.example — variabili per lo stack "gemello" (per NODO).
#
# Copia in ".env.cluster" su OGNI nodo e adatta i valori per-nodo.
#   cp .env.cluster.example .env.cluster
#
# Nodo A:  NODE_ID=A NODE_IP=10.0.0.1 PATRONI_NAME=node-a
# Nodo B:  NODE_ID=B NODE_IP=10.0.0.2 PATRONI_NAME=node-b
# Witness: (solo etcd) vedi docker-compose.etcd-witness.yml
# ─────────────────────────────────────────────────────────────────────────────

# Identità del nodo
NODE_ID=A
NODE_IP=10.0.0.1

# IP del peer gemello e del witness etcd (usati da compose per --initial-cluster)
NODE_A_IP=10.0.0.1
NODE_B_IP=10.0.0.2
ETCD_WITNESS_IP=10.0.0.3

# Nome logico del nodo per Patroni (node-a / node-b)
PATRONI_NAME=node-a
PATRONI_SCOPE=cms_cluster

# Credenziali PostgreSQL del cluster (Spilo crea/gestisce superuser + replica)
POSTGRES_USER=cmsuser
POSTGRES_DB=cms_sites
DB_PASSWORD=change-me-strong-password
REPLICATION_USER=replicator
REPLICATION_PASSWORD=change-me-replication-password
PATRONI_ADMIN_USER=patroni
PATRONI_ADMIN_PASSWORD=change-me-patroni-password

# URL completo usato dall'app verso il Postgres leader del cluster.
# Patroni espone il leader sulla rete cluster_net: usa il nome patroni-<NODE_ID>
# locale, Spilo lo punta sempre al membro leader reale (il container locale
# quando è leader, altrimenti l'altro nodo).
CLUSTER_DATABASE_URL=postgres://cmsuser:change-me-strong-password@patroni-A:5432/cms_sites

# Immagine Patroni/Spilo (arm64 o amd64)
PATRONI_IMAGE=ghcr.io/zalando/spilo-16:3.1-p1