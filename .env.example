# Environment variables for the multi-site CMS
# Copy to .env and customize:
#   cp .env.example .env
#
# All variables are optional unless marked Required.

# --- Required ---
DATABASE_URL=postgres://user:***@localhost:5432/mydb
JWT_SECRET=change-me-to-a-random-string

# --- Server ---
PORT=3000
NODE_ENV=development

# --- SMTP (email sending) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
MAGIC_LINK_BASE_URL=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info

# --- Branding ---
APP_NAME=CMS Multi-sito
APP_TAGLINE=
FOOTER_TAGLINE=
APP_LOGO_TEXT=CMS
ADMIN_TITLE=Pannello di amministrazione
SITE_DEFAULT_BRAND=Il mio sito
DEFAULT_LANG=it

# --- Features ---
STATIC_EXPORT_ENABLED=true
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14

# --- AI / LLM ---
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3
AUDIO_RETENTION_DAYS=0
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=

# --- Cloudflare deploy ---
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
DEPLOY_WEBHOOK_URL=

# --- Social publishing ---
TWITTER_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=

# --- Multi-nodo / Cluster (replica streaming + Patroni + Syncthing) ---
# Usate dallo stack "gemello" in infra/cluster/ (vedi docs/CLUSTER.it.md).
# Su un'installazione a singolo nodo queste variabili non servono.
# Ruolo del nodo per Patroni: node-a / node-b
PATRONI_NAME=node-a
PATRONI_SCOPE=cms_cluster
# Utente di replica streaming — identico su tutti i nodi
REPLICATION_USER=replicator
REPLICATION_PASSWORD=change-me-replication-password
# Utente amministrativo Patroni (REST API)
PATRONI_ADMIN_USER=patroni
PATRONI_ADMIN_PASSWORD=change-me-patroni-password
# URL del Postgres leader del cluster (usato dall'app sui nodi cluster)
CLUSTER_DATABASE_URL=postgres://cmsuser:change-me-strong-password@patroni-A:5432/cms_sites