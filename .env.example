PORT=3000
NODE_ENV=production

DATABASE_URL=postgres://cmsuser:changeme@db:5432/cms_sites
DB_PASSWORD=changeme

JWT_SECRET=generate_with_openssl_rand_hex_64

SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
MAGIC_LINK_BASE_URL=

LOG_LEVEL=info

# Branding (opzionali, default neutri se non impostati)
APP_NAME=CMS Multi-sito
APP_TAGLINE=
# Tagline mostrata nel footer dei siti pubblici (vuota = riga nascosta). Sovrascrivibile per sito con site_variables.footer_tagline.
FOOTER_TAGLINE=
APP_LOGO_TEXT=CMS
ADMIN_TITLE=Pannello di amministrazione
SITE_DEFAULT_BRAND=Il mio sito
DEFAULT_LANG=it

STATIC_EXPORT_ENABLED=true

# Backup DB automatico giornaliero (pg_dump compresso in ./backups, un file al giorno)
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14

# Integrazioni esterne (opzionali)
OPENAI_API_KEY=
# Provider LLM astratto (rewrite testo, alt-text) — se non impostate, usa OpenAI e OPENAI_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
DEPLOY_WEBHOOK_URL=
TWITTER_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=

# Trascrizione audio chiamate (feature call-recordings): Groq Whisper primario, fallback su OPENAI_API_KEY
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3
# Retention audio in giorni (0 = mai). Minimizzazione dati personali.
AUDIO_RETENTION_DAYS=0

# Stripe per i link di pagamento (feature 38): vuota = modalità conferma simulata
STRIPE_SECRET_KEY=
