<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof meta_title !== 'undefined' && meta_title ? meta_title : (typeof title !== 'undefined' && title ? title : brandName) %></title>
  <% if (typeof meta_description !== 'undefined' && meta_description) { %>
  <meta name="description" content="<%= meta_description %>">
  <% } %>
  <%- include('../partials/seo-meta') %>
  <%- include('../partials/tracking-head') %>
  <style>
    :root { --primary: <%= primaryColor %>; --secondary: <%= secondaryColor %>; --dark: #0C022E; --white: #ffffff; --gray: #8A8B94; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Poppins', sans-serif; color: var(--dark); line-height: 1.6; }
    a { color: var(--secondary); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .container { max-width: 1170px; margin: 0 auto; padding: 0 20px; }
    header { background: var(--dark); padding: 15px 0; }
    header .container { display: flex; justify-content: space-between; align-items: center; }
    header .logo { font-size: 24px; font-weight: 700; color: var(--white); text-decoration: none; }
    header nav a { color: var(--white); margin-left: 20px; font-size: 14px; }
    .page-content { min-height: 60vh; }
    footer { background: #0C0E1B; color: var(--gray); padding: 40px 0 20px; font-size: 13px; }
    footer .container { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 30px; }
    footer h4 { color: var(--white); margin-bottom: 10px; }
    footer a { color: var(--gray); }
    footer .bottom { grid-column: 1 / -1; border-top: 1px solid #383838; padding-top: 15px; text-align: center; font-size: 12px; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <a href="/" class="logo"><%= logoText %></a>
      <nav>
        <a href="/">Home</a>
      </nav>
    </div>
  </header>
  <div class="page-content">
    <%- typeof content !== 'undefined' ? content : body %>
  </div>
  <%- include('../partials/footer') %>
  <%- include('../partials/tracking-body') %>
</body>
</html>
