<h1>Modifica utente</h1>
<form method="POST" action="/admin/users/<%= user.id %>">
  <div class="form-group">
    <label>Email</label>
    <input type="email" name="email" value="<%= user.email %>" disabled style="background:#f5f5f5;">
  </div>
  <div class="form-group">
    <label>Nome</label>
    <input type="text" name="name" value="<%= user.name %>">
  </div>
  <div class="form-group">
    <label>Cognome</label>
    <input type="text" name="surname" value="<%= user.surname %>">
  </div>
  <div class="form-group">
    <label>Ruolo</label>
    <% const roleHints = {
      admin: 'Può gestire pagine, snippet, utenti e impostazioni del sito. Non può creare o eliminare siti.',
      collaboratore: 'Può modificare pagine e snippet. Non può gestire utenti né impostazioni.',
      setter: 'Account di servizio per il modulo vendite esterno (collego-sales): accesso SSO/API, nessun permesso admin.',
      closer: 'Account di servizio per il modulo vendite esterno (collego-sales): accesso SSO/API, nessun permesso admin.',
      superadmin: 'Accesso completo a tutti i siti, utenti e impostazioni.'
    }; %>
    <select name="role" onchange="document.getElementById('role-hint').textContent = this.options[this.selectedIndex].dataset.hint">
      <option value="admin" data-hint="<%= roleHints.admin %>" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
      <option value="collaboratore" data-hint="<%= roleHints.collaboratore %>" <%= user.role === 'collaboratore' ? 'selected' : '' %>>Collaboratore</option>
      <option value="setter" data-hint="<%= roleHints.setter %>" <%= user.role === 'setter' ? 'selected' : '' %>>Setter</option>
      <option value="closer" data-hint="<%= roleHints.closer %>" <%= user.role === 'closer' ? 'selected' : '' %>>Closer</option>
      <% if (viewerRole === 'superadmin') { %>
        <option value="superadmin" data-hint="<%= roleHints.superadmin %>" <%= user.role === 'superadmin' ? 'selected' : '' %>>Superadmin</option>
      <% } %>
    </select>
    <div id="role-hint" style="font-size:12px;color:#666;margin-top:4px;"><%= roleHints[user.role] || '' %></div>
  </div>
  <div class="form-group">
    <label>Sito</label>
    <select name="site_id">
      <option value="">— Nessuno —</option>
      <% sites.forEach(s => { %>
        <option value="<%= s.id %>" <%= user.site_id == s.id ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="form-group">
    <label>Status</label>
    <select name="status">
      <option value="active" <%= user.status === 'active' ? 'selected' : '' %>>Attivo</option>
      <option value="disabled" <%= user.status === 'disabled' ? 'selected' : '' %>>Disabilitato</option>
    </select>
  </div>
  <button type="submit" class="btn">Salva</button>
  <a href="/admin/users" class="btn" style="background:#6b7280;">Annulla</a>
</form>
