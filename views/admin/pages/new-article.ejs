<h1>Nuovo articolo — <%= site ? site.name : '' %></h1>
<form method="POST" action="/admin/pages">
  <input type="hidden" name="site_id" value="<%= site ? site.id : '' %>">
  <input type="hidden" name="post_type" value="article">
  <div class="form-group">
    <label>URL path</label>
    <input type="text" name="url_path" required placeholder="es. /articoli/il-mio-articolo">
  </div>
  <div class="form-group">
    <label>Titolo</label>
    <input type="text" name="title" required>
  </div>
  <div class="form-group">
    <label>Categoria</label>
    <select name="category_id">
      <option value="">— Nessuna —</option>
      <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
    </select>
  </div>
  <div class="form-group">
    <label>Excerpt (breve)</label>
    <textarea name="excerpt" rows="3" style="width:100%;"></textarea>
  </div>
  <div class="form-group">
    <label>Immagine in evidenza</label>
    <input type="text" name="featured_image" placeholder="https://... oppure /media/..." style="width:100%;">
    <% if (site) { %><div style="font-size:12px;color:#6b7280;margin-top:3px;"><a href="/admin/media?site_id=<%= site.id %>" target="_blank" rel="noopener">Apri libreria media</a> per copiare un URL.</div><% } %>
  </div>
  <div class="form-group">
    <label>Titolo breve per le card (opzionale)</label>
    <input type="text" name="card_title" placeholder="Lasciare vuoto per usare il titolo sopra" style="width:100%;">
  </div>
  <div class="form-group">
    <label>Tempo di lettura in minuti (opzionale)</label>
    <input type="number" name="reading_time_minutes" min="1" placeholder="Lasciare vuoto per la stima automatica" style="width:120px;">
  </div>
  <div class="form-group">
    <label>Modalità layout</label>
    <select name="layout_mode">
      <option value="wrapped">Wrapped (con layout sito)</option>
      <option value="standalone">Standalone (HTML puro)</option>
    </select>
  </div>
  <div class="form-group">
    <label><input type="checkbox" name="published" value="true" checked> Pubblicato subito</label>
  </div>
  <div class="form-group">
    <label>Pubblica automaticamente il <span style="font-weight:normal;color:#999;">(opzionale)</span></label>
    <input type="datetime-local" name="publish_at" value="">
  </div>
  <div class="form-group">
    <label>Contenuto HTML</label>
    <div style="font-size:12px;color:#666;margin-bottom:5px;">Usa <code>{{snippet:nome}}</code> per includere uno snippet.</div>
    <textarea name="content" id="pageContent"></textarea>
  </div>
  <button type="submit" class="btn">Crea articolo</button>
  <a href="/admin/pages?site_id=<%= site ? site.id : '' %>" class="btn" style="background:#6b7280;">Annulla</a>
</form>
