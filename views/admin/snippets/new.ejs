<h1>Nuovo snippet — <%= site ? site.name : '' %></h1>
<form method="POST" action="/admin/snippets">
  <input type="hidden" name="site_id" value="<%= site ? site.id : '' %>">
  <div class="form-group">
    <label>Nome</label>
    <input type="text" name="name" required placeholder="es. form-contatti, calendario-eventi">
    <div style="font-size:12px;color:#666;margin-top:3px;">Solo lettere, numeri, underscore e trattini.</div>
  </div>
  <div class="form-group">
    <label>Descrizione <span style="color:#e11d48;font-size:12px;">— obbligatoria per ritrovarlo facilmente</span></label>
    <input type="text" name="description" required placeholder="Es. Form di prenotazione call — sezione landing page">
    <div style="font-size:12px;color:#666;margin-top:3px;">Scrivi cosa fa e dove viene usato. Sarà visibile nella lista snippet senza dover aprire ogni elemento.</div>
  </div>
  <div class="form-group">
    <label>Contenuto HTML/JS/CSS</label>
    <textarea name="content" style="min-height:300px;"></textarea>
  </div>
  <button type="submit" class="btn">Crea snippet</button>
  <a href="/admin/snippets?site_id=<%= site ? site.id : '' %>" class="btn" style="background:#6b7280;">Annulla</a>
</form>
