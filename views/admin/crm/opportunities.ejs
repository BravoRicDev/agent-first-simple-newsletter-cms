<h1>Opportunità/affari — <%= site ? site.name : '' %></h1>

<% if (isSuperadmin && sites.length > 0) { %>
<form method="GET" style="margin-bottom:20px;display:flex;gap:10px;align-items:flex-end;">
  <div class="form-group" style="margin-bottom:0;">
    <label>Sito</label>
    <select name="site_id" onchange="this.form.submit()">
      <% sites.forEach(s => { %>
        <option value="<%= s.id %>" <%= siteId == s.id ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="form-group" style="margin-bottom:0;">
    <label>Stato</label>
    <select name="status" onchange="this.form.submit()">
      <option value="">Tutti</option>
      <option value="open" <%= status === 'open' ? 'selected' : '' %>>Aperte</option>
      <option value="won" <%= status === 'won' ? 'selected' : '' %>>Vinte</option>
      <option value="lost" <%= status === 'lost' ? 'selected' : '' %>>Perse</option>
    </select>
  </div>
</form>
<% } %>

<% if (saved) { %>
<div style="background:#d1fae5;border:1px solid #6ee7b7;border-radius:6px;padding:12px 16px;margin-bottom:20px;color:#065f46;font-size:14px;">✅ Salvato.</div>
<% } %>

<div style="display:flex;gap:30px;align-items:flex-start;flex-wrap:wrap;">
  <div style="flex:1;min-width:300px;">
    <% if (opportunities.length === 0) { %>
      <p style="color:#999;font-size:14px;">Nessuna opportunità.</p>
    <% } else { %>
    <table>
      <thead><tr><th>Titolo</th><th>Contatto</th><th>Stadio</th><th>Importo</th><th>Prob.</th><th>Stato</th><th>Preventivi</th></tr></thead>
      <tbody>
        <% opportunities.forEach(o => { %>
        <tr>
          <td><a href="/admin/opportunities/<%= o.id %>?site_id=<%= siteId %>"><%= o.title %></a></td>
          <td><%= o.contact_email %></td>
          <td><%= o.stage || '—' %></td>
          <td><%= new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(o.amount || 0) %></td>
          <td><%= o.probability != null ? o.probability + '%' : '—' %></td>
          <td><span class="badge <%= o.status === 'won' ? 'badge-active' : o.status === 'lost' ? 'badge-disabled' : '' %>"><%= o.status %></span></td>
          <td><%= o.quotes_count %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>

  <div style="flex:0 0 340px;min-width:280px;border:1px solid #e5e7eb;border-radius:6px;padding:16px;">
    <h2 style="font-size:15px;margin:0 0 12px;">Nuova opportunità</h2>
    <form method="POST" action="/admin/opportunities">
      <input type="hidden" name="site_id" value="<%= siteId %>">
      <div class="form-group"><label>Titolo *</label><input type="text" name="title" required placeholder="es. Sito vetrina per Mario"></div>
      <div class="form-group"><label>Email contatto *</label><input type="email" name="email" required></div>
      <div class="form-group">
        <label>Pipeline</label>
        <select name="pipeline_id">
          <option value="">— nessuna —</option>
          <% pipelines.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>Stadio</label><input type="text" name="stage" placeholder="es. proposta_inviata"></div>
      <div class="form-group"><label>Importo (€)</label><input type="number" step="0.01" min="0" name="amount" value="0"></div>
      <div class="form-group"><label>Probabilità (%)</label><input type="number" min="0" max="100" name="probability" value="0"></div>
      <div class="form-group"><label>Chiusura prevista</label><input type="date" name="expected_close_at"></div>
      <div class="form-group"><label>Note</label><textarea name="notes" rows="2"></textarea></div>
      <button class="btn">Crea</button>
    </form>
  </div>
</div>
