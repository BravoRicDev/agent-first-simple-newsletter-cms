<h1>Agent Builder — <%= site ? site.name : '' %></h1>
<p style="color:#777;font-size:13px;">Definizioni di agente configurabili via API con sandbox di test dry-run (nessun side-effect su conversazioni, task o tag).</p>

<% if (isSuperadmin && sites.length > 0) { %>
<form method="GET" style="margin-bottom:20px;display:flex;gap:10px;align-items:flex-end;">
  <div class="form-group" style="margin-bottom:0;">
    <label>Sito</label>
    <select name="site_id" onchange="this.form.submit()">
      <% sites.forEach(s => { %>
        <option value="<%= s.id %>" <%= siteId == s.id ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
  </div>
</form>
<% } %>

<% if (saved) { %>
<div style="background:#d1fae5;border:1px solid #6ee7b7;border-radius:6px;padding:12px 16px;margin-bottom:20px;color:#065f46;font-size:14px;">✅ Definizione salvata.</div>
<% } %>

<div style="display:flex;gap:30px;align-items:flex-start;flex-wrap:wrap;">
  <div style="flex:1;min-width:300px;">
    <h2 style="font-size:16px;">Definizioni esistenti</h2>
    <% if (definitions.length === 0) { %>
      <p style="color:#999;font-size:14px;">Nessuna definizione. Crea un agente con prompt, canali e strumenti consentiti, poi provalo nella sandbox.</p>
    <% } else { %>
    <table>
      <thead><tr><th>Nome</th><th>Canali</th><th>Stato</th><th>Config</th><th></th><th></th></tr></thead>
      <tbody>
        <% definitions.forEach(d => { %>
        <tr>
          <td><%= d.name %><br><span style="color:#999;font-size:11px;"><%= d.description || '' %></span></td>
          <td style="font-size:12px;"><%= (d.config.channels || []).join(', ') || '—' %></td>
          <td>
            <% if (d.sandbox) { %><span class="badge badge-warn">Sandbox</span><% } %>
            <% if (d.active) { %><span class="badge badge-active">Attivo</span><% } else { %><span class="badge badge-disabled">Off</span><% } %>
          </td>
          <td style="font-size:11px;max-width:220px;word-break:break-all;"><%= JSON.stringify(d.config).slice(0, 160) %></td>
          <td>
            <form method="POST" action="/admin/agent-builder/<%= d.id %>/test" style="display:inline;">
              <input type="hidden" name="site_id" value="<%= siteId %>">
              <input type="hidden" name="message" value="Ciao, vorrei un preventivo">
              <button class="btn btn-sm">Test</button>
            </form>
          </td>
          <td>
            <form method="POST" action="/admin/agent-builder/<%= d.id %>/delete" style="display:inline;" onsubmit="return confirm('Eliminare la definizione?');">
              <input type="hidden" name="site_id" value="<%= siteId %>">
              <button class="btn btn-sm btn-danger">Elimina</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>

    <% if (testResult) { %>
    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;padding:12px 16px;margin-top:20px;color:#1e3a8a;font-size:14px;">
      <strong>Risposta sandbox:</strong> <%= testResult.reply %><br>
      <span style="font-size:11px;color:#64748b;">run #<%= testResult.sandbox_run_id %> · definizione #<%= testResult.definition_id %></span>
    </div>
    <% } %>
    <% if (testError) { %>
    <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:6px;padding:12px 16px;margin-top:20px;color:#991b1b;font-size:14px;">
      ⚠️ <%= testError %>
    </div>
    <% } %>

    <h2 style="font-size:16px;margin-top:24px;">Ultimi test sandbox</h2>
    <% if (runs.length === 0) { %>
      <p style="color:#999;font-size:14px;">Nessun test eseguito finora.</p>
    <% } else { %>
    <table>
      <thead><tr><th>#</th><th>Definizione</th><th>Input</th><th>Output</th><th>Data</th></tr></thead>
      <tbody>
        <% runs.forEach(r => { %>
        <tr>
          <td><%= r.id %></td>
          <td><%= r.agent_definition_id || '—' %></td>
          <td style="font-size:11px;max-width:180px;word-break:break-all;"><%= String(r.input.message || '').slice(0, 80) %></td>
          <td style="font-size:11px;max-width:220px;word-break:break-all;"><%= String(r.output.reply || '').slice(0, 120) %></td>
          <td style="font-size:11px;"><%= new Date(r.created_at).toLocaleString('it-IT') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>

  <div style="flex:1;min-width:320px;">
    <h2 style="font-size:16px;">Nuova definizione</h2>
    <form method="POST" action="/admin/agent-builder">
      <input type="hidden" name="site_id" value="<%= siteId %>">
      <div class="form-group">
        <label>Nome</label>
        <input type="text" name="name" required placeholder="Es. Assistente commerciale WhatsApp">
      </div>
      <div class="form-group">
        <label>Descrizione (opzionale)</label>
        <input type="text" name="description" placeholder="Es. Risponde ai lead in arrivo">
      </div>
      <div class="form-group">
        <label>Config (JSON)</label>
        <textarea name="config_json" style="min-height:180px;font-family:monospace;font-size:12px;" placeholder='{
  "prompt": "Sei un assistente commerciale...",
  "model": "gpt-4o-mini",
  "channels": ["whatsapp", "email", "chat"],
  "tools_allowed": ["add_tag", "create_task"],
  "reply_style": "amichevole e conciso",
  "default_reply": "Grazie, ti ricontattiamo a breve.",
  "temperature": 0.7
}'></textarea>
        <div style="font-size:11px;color:#999;margin-top:4px;">Chiavi supportate: prompt, model, channels (whatsapp/email/chat/all), tools_allowed, reply_style, default_reply, temperature (0–2). Max 100KB.</div>
      </div>
      <div style="display:flex;gap:16px;margin-bottom:14px;">
        <label style="font-size:13px;"><input type="checkbox" name="sandbox" value="1"> In sandbox (in prova)</label>
        <label style="font-size:13px;"><input type="checkbox" name="active" value="1" checked> Attiva</label>
      </div>
      <button class="btn">Salva definizione</button>
    </form>

    <h2 style="font-size:16px;margin-top:24px;">Test manuale sandbox</h2>
    <form method="POST" action="/admin/agent-builder/<%= definitions[0] ? definitions[0].id : 0 %>/test" onsubmit="this.action='/admin/agent-builder/'+document.getElementById('test_def_id').value+'/test'">
      <input type="hidden" name="site_id" value="<%= siteId %>">
      <div class="form-group">
        <label>Definizione</label>
        <select id="test_def_id" name="definition_id">
          <% definitions.forEach(d => { %>
            <option value="<%= d.id %>"><%= d.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Messaggio</label>
        <textarea name="message" style="min-height:70px;" required placeholder="Ciao, vorrei un preventivo..."></textarea>
      </div>
      <div style="display:flex;gap:16px;">
        <div class="form-group">
          <label>Email contatto</label>
          <input type="email" name="contact_email" placeholder="mario@example.it">
        </div>
        <div class="form-group">
          <label>Canale</label>
          <select name="channel">
            <option value="">—</option>
            <option value="whatsapp">WhatsApp</option>
            <option value="email">Email</option>
            <option value="chat">Chat</option>
            <option value="all">Tutti</option>
          </select>
        </div>
      </div>
      <button class="btn">▶ Esegui test sandbox</button>
    </form>
  </div>
</div>
