<h1>Automazioni (workflow) — <%= site ? site.name : '' %></h1>
<p style="color:#666;font-size:14px;margin-bottom:20px;">Un workflow parte quando accade un <strong>evento</strong> (form, quiz, email, chiamata, stadio...) ed esegue <strong>azioni in sequenza</strong>: tag, stadio, email, task, notifica, oppure <strong>spara un webhook a n8n</strong> per le automazioni complesse.</p>

<% if (isSuperadmin && sites.length > 0) { %>
<form method="GET" style="margin-bottom:20px;display:flex;gap:10px;align-items:flex-end;">
  <div class="form-group" style="margin-bottom:0;">
    <label>Sito</label>
    <select name="site_id" onchange="this.form.submit()">
      <% sites.forEach(s => { %>
        <option value="<%= s.id %>" <%= siteId == s.id ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
  </div>
</form>
<% } %>

<% if (saved) { %>
<div style="background:#d1fae5;border:1px solid #6ee7b7;border-radius:6px;padding:12px 16px;margin-bottom:20px;color:#065f46;font-size:14px;">✅ Workflow salvato.</div>
<% } %>

<div style="display:flex;gap:30px;align-items:flex-start;flex-wrap:wrap;">
  <div style="flex:1;min-width:300px;">
    <h2 style="font-size:16px;">Workflow esistenti</h2>
    <% if (workflows.length === 0) { %>
      <p style="color:#999;font-size:14px;">Nessuna automazione. Clicca "Nuovo workflow" per crearne una.</p>
    <% } else { %>
    <table>
      <thead><tr><th>Nome</th><th>Trigger</th><th>Azioni</th><th>Stato</th><th></th></tr></thead>
      <tbody>
        <% workflows.forEach(w => { %>
        <tr>
          <td><strong><%= w.name %></strong></td>
          <td><code><%= w.trigger_type %></code><br><span style="font-size:11px;color:#666;"><%= Object.keys(w.trigger_config||{}).length ? JSON.stringify(w.trigger_config) : 'tutti' %></span></td>
          <td><%= w.action_count %></td>
          <td>
            <form method="POST" action="/admin/workflows/<%= w.id %>/toggle" style="display:inline;">
              <input type="hidden" name="site_id" value="<%= siteId %>">
              <input type="hidden" name="active" value="<%= w.active ? 0 : 1 %>">
              <% if (w.active) { %><button class="btn btn-sm" style="background:#d1fae5;color:#065f46;" title="Clicca per disattivare">● Attivo</button><% } else { %><button class="btn btn-sm" style="background:#f3f4f6;color:#6b7280;" title="Clicca per attivare">○ Off</button><% } %>
            </form>
          </td>
          <td>
            <form method="POST" action="/admin/workflows/<%= w.id %>/delete" style="display:inline;" onsubmit="return confirm('Eliminare il workflow?');">
              <input type="hidden" name="site_id" value="<%= siteId %>">
              <button class="btn btn-sm" style="background:#dc2626;">Elimina</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>

  <% if (typeof showDelayed !== "undefined" && showDelayed && delayedActions && delayedActions.length > 0) { %>
  <div style="flex:1;min-width:340px;background:#e2e8f0;border-left:4px solid #63b3ed;padding:16px;margin-left:30px;border-radius:6px;">
    <h2 style="font-size:16px;margin-bottom:12px;">Azioni differite in attesa</h2>
    <% const pending = delayedActions.filter(a => a.status === 'pending'); %>
    <% if (pending.length > 0) { %>
    <p style="font-size:12px;color:#666;margin-bottom:12px;">Totale azioni differite: <%= delayedActions.length %> (in attesa: <%= pending.length %>)</p>
    <table style="width:100%;border-collapse:collapse;font-size:12px;">
      <thead><tr><th>Email</th><th>Azioni</th><th>Run at</th><th>Stato</th></tr></thead>
      <tbody>
        <% pending.forEach(a => { %>
        <tr style="background:<%= a.executed_at ? '#f3f4f6' : '#ffffff' %>;">
          <td style="padding:6px 8px;"><%= a.email %></td>
          <td style="padding:6px 8px;"><%= a.action_type %>: <%= JSON.stringify(a.action_config).slice(0,80) %></td>
          <td style="padding:6px 8px;"><%= a.run_at.toLocaleString() %></td>
          <td style="padding:6px 8px;color:#65a30d;"><%= a.status %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <p style="color:#666;font-size:13px;margin:10px 0;">Nessuna azione in attesa scadente in questo momento.</p>
    <% } %>
    <% delayedActions.forEach(a => { %>
    <% if (a.status !== 'pending') { %>
    <p style="font-size:11px;color:#b91c1c;margin:6px 0;">ID <%= a.id %>: <%= a.action_type %> per <%= a.email %> - scaduto il <%= a.run_at.toLocaleString() %> - <%= a.status %> <%= a.executed_at ? '(eseguita)' : '' %></p>
    <% } %>
<% }) %>
  </div>
  <% } %>

  <% if (typeof showAnalytics !== "undefined" && showAnalytics && workflowAnalytics) { %>
  <div style="flex:1;min-width:340px;background:#eef2ff;border-left:4px solid #6366f1;padding:16px;margin-left:30px;border-radius:6px;">
    <h2 style="font-size:16px;margin-bottom:12px;">📊 Analytics workflow</h2>
    <p style="font-size:12px;color:#666;margin-bottom:12px;">Success rate, tempi di esecuzione e SLA per le automazioni.</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:12px;">
      <div style="background:#fff;border-radius:6px;padding:10px 14px;text-align:center;">
        <div style="font-size:22px;font-weight:700;"><%= workflowAnalytics.totals.total_runs %></div>
        <div style="font-size:11px;color:#666;">Run totali</div>
      </div>
      <div style="background:#fff;border-radius:6px;padding:10px 14px;text-align:center;">
        <div style="font-size:22px;font-weight:700;color:#16a34a;"><%= workflowAnalytics.totals.ok_runs %></div>
        <div style="font-size:11px;color:#666;">OK</div>
      </div>
      <div style="background:#fff;border-radius:6px;padding:10px 14px;text-align:center;">
        <div style="font-size:22px;font-weight:700;color:#dc2626;"><%= workflowAnalytics.totals.error_runs %></div>
        <div style="font-size:11px;color:#666;">Errori</div>
      </div>
      <div style="background:#fff;border-radius:6px;padding:10px 14px;text-align:center;">
        <div style="font-size:22px;font-weight:700;"><%= workflowAnalytics.totals.avg_duration_ms %>ms</div>
        <div style="font-size:11px;color:#666;">Media</div>
      </div>
      <div style="background:#fff;border-radius:6px;padding:10px 14px;text-align:center;">
        <div style="font-size:22px;font-weight:700;"><%= workflowAnalytics.totals.p95_duration_ms %>ms</div>
        <div style="font-size:11px;color:#666;">P95 (SLA)</div>
      </div>
    </div>
    <h3 style="font-size:13px;margin:0 0 8px 0;">Per workflow</h3>
    <table style="width:100%;border-collapse:collapse;font-size:12px;background:#fff;border-radius:6px;">
      <thead><tr><th>Workflow</th><th>Run</th><th>OK</th><th>Err</th><th>Media</th></tr></thead>
      <tbody>
        <% if (workflowAnalytics.per_workflow.length === 0) { %>
        <tr><td colspan="5" style="text-align:center;color:#999;padding:8px;">Nessun dato</td></tr>
        <% } else { %>
        <% workflowAnalytics.per_workflow.forEach(pw => { %>
        <tr>
          <td style="padding:4px 6px;"><%= pw.name || ('#'+pw.workflow_id) %></td>
          <td style="padding:4px 6px;"><%= pw.runs %></td>
          <td style="padding:4px 6px;color:#16a34a;"><%= pw.ok %></td>
          <td style="padding:4px 6px;color:#dc2626;"><%= pw.errors %></td>
          <td style="padding:4px 6px;"><%= pw.avg_duration_ms %>ms</td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>
    <h3 style="font-size:13px;margin:12px 0 8px 0;">Per trigger</h3>
    <table style="width:100%;border-collapse:collapse;font-size:12px;background:#fff;border-radius:6px;">
      <thead><tr><th>Trigger</th><th>Run</th><th>OK</th><th>Err</th></tr></thead>
      <tbody>
        <% if (workflowAnalytics.per_trigger.length === 0) { %>
        <tr><td colspan="4" style="text-align:center;color:#999;padding:8px;">Nessun dato</td></tr>
        <% } else { %>
        <% workflowAnalytics.per_trigger.forEach(pt => { %>
        <tr>
          <td style="padding:4px 6px;"><code><%= pt.trigger_type %></code></td>
          <td style="padding:4px 6px;"><%= pt.runs %></td>
          <td style="padding:4px 6px;color:#16a34a;"><%= pt.ok %></td>
          <td style="padding:4px 6px;color:#dc2626;"><%= pt.errors %></td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>

  <div style="flex:1;min-width:340px;">
    <h2 style="font-size:16px;">Nuovo workflow</h2>
    <form method="POST" action="/admin/workflows">
      <input type="hidden" name="site_id" value="<%= siteId %>">
      <input type="hidden" name="trigger_config_json" id="trigger_config_json" value="{}">
      <input type="hidden" name="actions_json" id="actions_json" value="[]">
      <div class="form-group">
        <label>Nome</label>
        <input type="text" name="name" required placeholder="Es. Quiz alto → webhook n8n">
      </div>
      <div class="form-group">
        <label>Trigger (evento)</label>
        <select name="trigger_type" id="trigger_type">
          <option value="form_submitted">📝 Form inviato</option>
          <option value="quiz_completed">🎯 Quiz completato</option>
          <option value="contact_created">👤 Contatto creato</option>
          <option value="email_opened">📧 Email aperta</option>
          <option value="email_clicked">🔗 Email cliccata</option>
          <option value="call_booked">📞 Chiamata prenotata</option>
          <option value="call_status_changed">📞 Stato chiamata cambiato</option>
          <option value="stage_changed">🔄 Stadio pipeline cambiato</option>
          <option value="tag_added">🏷️ Tag aggiunto</option>
          <option value="score_threshold">📈 Punteggio soglia</option>
          <option value="segment_entered">🗂️ Entrato in segmento</option>
          <option value="note_added">📝 Nota aggiunta</option>
          <option value="conversation_message">💬 Messaggio conversazione</option>
          <option value="opportunity_stage_changed">💰 Stadio opportunità cambiato</option>
          <option value="quote_signed">✍️ Preventivo firmato</option>
          <option value="manual">🖐️ Manuale</option>
          <option value="agent_runtime">🤖 Runtime agente</option>
          <option value="agent_handoff">🤝 Hand-off agente</option>
          <option value="conversation_started">💬 Conversazione avviata</option>
        </select>
      </div>
      <div class="form-group">
        <label>Config trigger (JSON opzionale — es. {"quiz_slug":"qualifica-lead","min_score":8})</label>
        <input type="text" id="trigger_config_text" style="font-family:monospace;font-size:12px;" placeholder='{"quiz_slug":"qualifica-lead","min_score":8}'>
      </div>
      <div class="form-group">
        <label>Azioni (in sequenza)</label>
        <div id="actions_list"></div>
        <!-- Inizio pannello Mappa campi: il markup viene generato lato client da
             buildFieldPanelHTML()/refreshFieldPanel() (script in fondo alla pagina),
             che lo inseriscono subito dopo #actions_list. -->
        <button type="button" class="btn btn-sm" onclick="addActionRow()" style="margin-top:6px;">+ Aggiungi azione</button>
        <div style="font-size:11px;color:#999;margin-top:6px;">
          <strong>send_webhook</strong>: importa {url, secret, event_type, payload} — ponte per n8n.<br>
          <strong>emit_event</strong>: {event_type} — ri-emette un evento nel bus (altri workflow/webhook lo inoltrano).<br>
          <strong>add_note</strong>: {note} — aggiunge una nota al contatto.
        </div>
      </div>
      <button class="btn">Salva workflow</button>
    </form>
  </div>
</div>

<script>
// ── Mappa campi CRM — placeholder {{campo}} da inserire nel JSON config ────────
//
// Campo cliccato → inserisce {{path}} nella posizione del cursore dell'input
// "action-cfg" attualmente in focus. Se nessun input ha focus, si usa l'ultimo
// aggiunto. Sintassi mustache {{path}}, coerente con renderTemplate() in
// src/services/webhooks.js.
//
// IMPORTANTE: i placeholder qui sotto NON sono nomi di campo generici del
// CRM — sono le chiavi REALI presenti nel "payload" passato a
// emitContactEvent() per ciascun trigger (verificate leggendo i call-site in
// src/services/*.js, es. opportunities.js, contacts.js, booking.js). Il
// contesto disponibile in executeAction (src/services/workflows.js) è
// { ...payload, email, event }: è FLAT, non esistono chiavi annidate tipo
// "contact.email" o "opportunity.title" — usarle avrebbe SEMPRE risolto a
// stringa vuota. Per questo i campi sono raggruppati per trigger_type: solo
// quelli del trigger selezionato nel form hanno senso per il workflow in
// creazione. "email" ed "event" sono gli unici due SEMPRE disponibili
// (aggiunti esplicitamente al contesto da executeAction indipendentemente
// dal payload del trigger).
//
// ⚠️ I placeholder vengono risolti al momento dell'esecuzione del workflow
// (in executeAction di src/services/workflows.js), non al submit del form.
//
// ──────────────────────────────────────────────────────────────────────────────

// Inserisce testo 'text' nella posizione del cursore dell'input focused.
// Se nessun input .action-cfg ha focus, agisce sull'ultimo .action-cfg.
function insertPlaceholderAtCursor(text) {
  const inputs = document.querySelectorAll('.action-cfg');
  if (inputs.length === 0) return;
  let target = null;
  // Cerca un input che abbia il focus attivo
  for (const inp of inputs) {
    if (document.activeElement === inp) { target = inp; break; }
  }
  // Se nulla ha focus, usa l'ultimo
  if (!target) target = inputs[inputs.length - 1];
  if (!target) return;
  const start = target.selectionStart;
  const end = target.selectionEnd;
  const value = target.value;
  target.value = value.slice(0, start) + text + value.slice(end);
  // Posiziona il cursore dopo il testo inserito
  target.selectionStart = target.selectionEnd = start + text.length;
}

// Campi SEMPRE disponibili, indipendentemente dal trigger (aggiunti da
// executeAction al contesto, non fanno parte del payload del trigger).
const COMMON_FIELDS = {
  'Email contatto': '{{email}}',
  'Tipo evento': '{{event}}',
};

// Campi per trigger_type: chiavi REALI del payload passato a
// emitContactEvent() per ciascun evento (verificate nel codice sorgente,
// non inventate). Trigger non elencati qui non hanno campi payload noti
// oltre a COMMON_FIELDS (es. "manual", "contact_created" passa solo
// {source} interno, non utile da esporre).
const FIELD_MAP_BY_TRIGGER = {
  form_submitted: { 'Slug del form': '{{form_slug}}' },
  tag_added: { 'Tag aggiunto': '{{tag}}' },
  stage_changed: { 'Nuovo stadio pipeline': '{{to_stage}}' },
  opportunity_stage_changed: {
    'ID opportunità': '{{opportunity_id}}',
    'Titolo opportunità': '{{title}}',
    'Nuovo stadio': '{{to_stage}}',
    'Stadio precedente': '{{from_stage}}',
  },
  call_status_changed: {
    'Stato chiamata': '{{status}}',
    'ID chiamata': '{{call_id}}',
  },
  segment_entered: { 'ID segmento': '{{segment_id}}' },
  quote_signed: {
    'ID preventivo': '{{quote_id}}',
    'Numero preventivo': '{{quote_number}}',
    'Titolo preventivo': '{{title}}',
  },
};

// Costruisce l'HTML del pannello mappa campi per il trigger_type corrente
function buildFieldPanelHTML() {
  const triggerSel = document.getElementById('trigger_type');
  const currentTrigger = triggerSel ? triggerSel.value : '';
  const specific = FIELD_MAP_BY_TRIGGER[currentTrigger] || {};
  const allFields = { ...COMMON_FIELDS, ...specific };

  const rows = [];
  for (const [label, path] of Object.entries(allFields)) {
    rows.push(`
      <button type="button" class="btn btn-sm" style="padding:4px 8px;margin:2px;white-space:normal;text-align:left;background:#eef2ff;color:#3730a3;"
          onclick="insertPlaceholderAtCursor('${path}')" title="Clicca per inserire ${path} nel campo config dell'azione attiva">
        ${label}
      </button>
    `);
  }
  const noSpecific = Object.keys(specific).length === 0;
  return `
    <div id="field-map-panel" style="position:relative;z-index:100;margin-top:16px;">
      <h3 style="font-size:13px;margin:0 0 6px 0;">🗺️ Mappa campi (trigger: ${currentTrigger || '—'})</h3>
      <div style="background:#f8f9fa;border:1px solid #e3e6e9;border-radius:6px;padding:8px 12px;margin-bottom:8px;font-size:12px;color:#495057;">
        Clicca un campo per inserirlo nel punto del cursore dell'input "Config JSON" dell'azione selezionata (o dell'ultima aggiunta, se nessuna è a fuoco).
        ${noSpecific ? '<br><em>Questo trigger non espone campi specifici oltre a quelli sempre disponibili.</em>' : ''}
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:2px;">
        ${rows.join('')}
      </div>
    </div>
  `;
}

// Ridisegna il pannello (usato sia al load sia al cambio di trigger_type)
function refreshFieldPanel() {
  const existing = document.getElementById('field-map-panel');
  if (existing) existing.remove();
  const actionsList = document.getElementById('actions_list');
  if (actionsList) {
    actionsList.insertAdjacentHTML('afterend', buildFieldPanelHTML());
  }
}

// Inizializza il pannello mappa campi e lo aggiorna quando cambia il trigger
document.addEventListener('DOMContentLoaded', () => {
  refreshFieldPanel();
  const triggerSel = document.getElementById('trigger_type');
  if (triggerSel) triggerSel.addEventListener('change', refreshFieldPanel);
});

// Delegazione click: click fuori dal pannello chiude la attenzione (semplicità: non chiudiamo nulla,
// il pannello resta visibile finché l'utente interagisce altrove)
document.addEventListener('click', (e) => {
  // Impedisce che il click su un bottone campo chiuda o interferisca con altro
  if (e.target.closest('#field-map-panel')) return;
  // Opzionale: chiudi il pannello click ovunque fuori (disabilitato per semplicità)
});

const ACTION_HELP = {
  add_tag: { help: '{ "tag": "lead-caldo" }' },
  remove_tag: { help: '{ "tag": "vecchio-tag" }' },
  set_stage: { help: '{ "stage": "chiamata_fissata" }' },
  create_task: { help: '{ "title": "Chiama il lead", "due_in_days": 1 }' },
  notify_email: { help: '{ "to": "vendi@dominio.it", "subject": "...", "body": "..." }' },
  wait_days: { help: '{ "days": 2 }' },
  send_campaign: { help: '{ "campaign_id": 3 }' },
  send_sequence: { help: '{ "step_id": 5 }' },
  send_webhook: { help: '{ "url": "https://hook.n8n.cloud/...", "secret": "...", "event_type": "lead.generated" }' },
  emit_event: { help: '{ "event_type": "lead_qualified" }' },
  add_note: { help: '{ "note": "Compilato il quiz" }' },
};

function addActionRow(type = 'add_tag', cfgText = '') {
  const list = document.getElementById('actions_list');
  const row = document.createElement('div');
  row.style.cssText = 'display:flex;gap:6px;align-items:center;margin-bottom:6px;';
  row.innerHTML = `
    <select class="action-type" onchange="updateActionHelp(this)" style="flex:0 0 140px;">
      ${Object.keys(ACTION_HELP).map(t => `<option value="${t}" ${t === type ? 'selected' : ''}>${t}</option>`).join('')}
    </select>
    <input type="text" class="action-cfg" placeholder="Config JSON" value="${cfgText}" style="flex:1;font-family:monospace;font-size:12px;">
    <button type="button" class="btn btn-sm" style="background:#dc2626;" onclick="this.parentElement.remove()">✕</button>
  `;
  list.appendChild(row);
}

function updateActionHelp(sel) {
  const row = sel.closest('div');
  const cfg = row.querySelector('.action-cfg');
  const type = sel.value;
  if (ACTION_HELP[type] && !cfg.value.trim()) cfg.placeholder = ACTION_HELP[type].help;
}

document.addEventListener('DOMContentLoaded', () => {
  addActionRow();
  const form = document.querySelector('form[action="/admin/workflows"]');
  form.addEventListener('submit', () => {
    const tc = document.getElementById('trigger_config_text').value.trim();
    try { document.getElementById('trigger_config_json').value = tc ? JSON.stringify(JSON.parse(tc)) : '{}'; }
    catch { document.getElementById('trigger_config_json').value = '{}'; }

    const actions = [];
    document.querySelectorAll('#actions_list > div').forEach(row => {
      const type = row.querySelector('.action-type').value;
      const cfg = row.querySelector('.action-cfg').value.trim();
      let parsed = {};
      if (cfg) { try { parsed = JSON.parse(cfg); } catch { parsed = {}; } }
      actions.push({ action_type: type, action_config: parsed });
    });
    document.getElementById('actions_json').value = JSON.stringify(actions);
  });
});
</script>