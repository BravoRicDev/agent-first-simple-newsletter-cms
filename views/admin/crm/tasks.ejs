<h1>Task — <%= site ? site.name : '' %></h1>

<% if (isSuperadmin && sites.length > 0) { %>
<form method="GET" style="margin-bottom:20px;display:flex;gap:10px;align-items:flex-end;">
  <div class="form-group" style="margin-bottom:0;">
    <label>Sito</label>
    <select name="site_id" onchange="this.form.submit()">
      <% sites.forEach(s => { %>
        <option value="<%= s.id %>" <%= siteId == s.id ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
  </div>
</form>
<% } %>

<% if (saved) { %>
<div style="background:#d1fae5;border:1px solid #6ee7b7;border-radius:6px;padding:12px 16px;margin-bottom:20px;color:#065f46;font-size:14px;">✅ Task salvata.</div>
<% } %>

<div class="actions">
  <a href="/admin/tasks?site_id=<%= siteId %>&status=open" class="btn btn-sm <%= !req.query.status || req.query.status === 'open' ? '' : 'btn-secondary' %>">Aperte</a>
  <a href="/admin/tasks?site_id=<%= siteId %>&status=done" class="btn btn-sm">Fatte</a>
</div>

<div style="display:flex;gap:30px;align-items:flex-start;flex-wrap:wrap;">
  <div style="flex:1;min-width:300px;">
    <% if (tasks.length === 0) { %>
      <p style="color:#999;font-size:14px;">Nessuna task <%= req.query.status === 'done' ? 'completata' : 'aperta' %>.</p>
    <% } else { %>
    <table>
      <thead><tr><th>Titolo</th><th>Contatto</th><th>Assegnata a</th><th>Scadenza</th><th></th></tr></thead>
      <tbody>
        <% tasks.forEach(t => { %>
        <tr>
          <td><%= t.title %></td>
          <td><%= t.email || '—' %></td>
          <td><%= t.assignee_name || t.assignee_email || '—' %></td>
          <td><%= t.due_at ? new Date(t.due_at).toLocaleString('it-IT') : '—' %></td>
          <td style="white-space:nowrap;">
            <% if (t.status === 'open') { %>
            <form method="POST" action="/admin/tasks/<%= t.id %>/status" style="display:inline;">
              <input type="hidden" name="site_id" value="<%= siteId %>">
              <input type="hidden" name="status" value="done">
              <button class="btn btn-sm" style="background:#059669;">✓ Fatto</button>
            </form>
            <% } %>
            <form method="POST" action="/admin/tasks/<%= t.id %>/delete" style="display:inline;" onsubmit="return confirm('Eliminare?');">
              <input type="hidden" name="site_id" value="<%= siteId %>">
              <button class="btn btn-sm btn-danger">Elimina</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>

  <div style="flex:1;min-width:300px;">
    <h2 style="font-size:16px;">Nuova task</h2>
    <form method="POST" action="/admin/tasks">
      <input type="hidden" name="site_id" value="<%= siteId %>">
      <div class="form-group">
        <label>Titolo</label>
        <input type="text" name="title" required placeholder="Es. Chiama Mario per il preventivo">
      </div>
      <div class="form-group">
        <label>Email contatto (opzionale)</label>
        <input type="email" name="email" placeholder="lead@example.it">
      </div>
      <div class="form-group">
        <label>Assegnata a</label>
        <select name="assignee_id">
          <option value="">— Nessuno —</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>"><%= u.name || u.email %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Scadenza (opzionale)</label>
        <input type="datetime-local" name="due_at">
      </div>
      <div class="form-group">
        <label>Note (opzionale)</label>
        <textarea name="notes" style="min-height:60px;"></textarea>
      </div>
      <button class="btn">Crea task</button>
    </form>
  </div>
</div>
