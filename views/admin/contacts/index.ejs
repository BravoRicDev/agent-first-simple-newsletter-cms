<h1>Contatti — <%= site ? site.name : '' %></h1>

<div class="actions">
  <a href="/admin/forms?site_id=<%= siteId %>" class="btn" style="background:#6b7280;">← Torna ai form</a>
</div>

<% if (typeof erased !== 'undefined' && erased) { %>
<div style="background:#d1fae5;border:1px solid #6ee7b7;border-radius:6px;padding:12px 16px;margin:15px 0;color:#065f46;font-size:14px;">
  ✅ Dati del contatto cancellati.
</div>
<% } %>

<p style="font-size:12px;color:#666;max-width:600px;">
  Un contatto viene riconosciuto dal campo email compilato in uno o più form.
  Gli invii senza un campo email riconoscibile non compaiono qui, ma restano
  visibili nella sezione Form.
</p>

<% if (tags.length > 0) { %>
<form method="GET" style="margin:15px 0;display:flex;gap:10px;align-items:flex-end;">
  <input type="hidden" name="site_id" value="<%= siteId %>">
  <div class="form-group" style="margin-bottom:0;">
    <label>Filtra per tag</label>
    <select name="tag" onchange="this.form.submit()">
      <option value="">Tutti i contatti</option>
      <% tags.forEach(tag => { %>
        <option value="<%= tag %>" <%= tagFilter === tag ? 'selected' : '' %>><%= tag %></option>
      <% }) %>
    </select>
  </div>
</form>
<% } %>

<% if (contacts.length === 0) { %>
  <p style="color:#999;font-size:14px;"><%= tagFilter ? 'Nessun contatto con questo tag.' : 'Nessun contatto identificabile ancora.' %></p>
<% } else { %>
<table>
  <thead>
    <tr><th>Email</th><th>Tag</th><th>Form compilati</th><th>Invii totali</th><th>Primo contatto</th><th>Ultimo contatto</th><th></th></tr>
  </thead>
  <tbody>
    <% contacts.forEach(c => { %>
    <tr>
      <td><%= c.email %></td>
      <td>
        <% (c.tags || []).forEach(tag => { %><span style="background:#e0e7ff;color:#3730a3;font-size:11px;padding:1px 6px;border-radius:4px;margin-right:3px;"><%= tag %></span><% }) %>
        <% if (c.status) { %><span style="background:#f3f4f6;color:#374151;font-size:11px;padding:1px 6px;border-radius:4px;"><%= c.status %></span><% } %>
      </td>
      <td>
        <% c.forms.forEach(f => { %><code style="margin-right:4px;"><%= f %></code><% }) %>
        <% if (c.formsCount > 1) { %><span style="background:#fef3c7;color:#92400e;font-size:11px;padding:1px 6px;border-radius:4px;margin-left:4px;">×<%= c.formsCount %></span><% } %>
      </td>
      <td><%= c.total %></td>
      <td style="white-space:nowrap;"><%= new Date(c.firstSeen).toLocaleDateString('it-IT') %></td>
      <td style="white-space:nowrap;"><%= new Date(c.lastSeen).toLocaleDateString('it-IT') %></td>
      <td><a href="/admin/contacts/<%= encodeURIComponent(c.email) %>?site_id=<%= siteId %>" class="btn btn-sm">Vedi storico</a></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>
