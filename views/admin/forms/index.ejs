<h1>Form — <%= site ? site.name : '' %></h1>

<% if (isSuperadmin && sites.length > 0) { %>
<form method="GET" style="margin-bottom:20px;display:flex;gap:10px;align-items:flex-end;">
  <div class="form-group" style="margin-bottom:0;">
    <label>Sito</label>
    <select name="site_id" onchange="this.form.submit()">
      <% sites.forEach(s => { %>
        <option value="<%= s.id %>" <%= siteId == s.id ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
  </div>
</form>
<% } %>

<% if (saved) { %>
<div style="background:#d1fae5;border:1px solid #6ee7b7;border-radius:6px;padding:12px 16px;margin-bottom:20px;color:#065f46;font-size:14px;">
  ✅ Form salvato correttamente.
</div>
<% } %>

<div class="actions">
  <a href="/admin/forms/new?site_id=<%= siteId %>" class="btn">Nuovo form</a>
  <a href="/admin/forms/search?site_id=<%= siteId %>" class="btn" style="background:#6b7280;">🔍 Cerca negli invii</a>
  <a href="/admin/contacts?site_id=<%= siteId %>" class="btn" style="background:#6b7280;">👤 Contatti</a>
</div>

<% if (definitions.length === 0) { %>
  <p style="color:#999;font-size:14px;">Nessun form creato con il form builder.</p>
<% } else { %>
<table>
  <thead>
    <tr><th>Nome</th><th>Slug</th><th>Invii totali</th><th>Ultimo invio</th><th></th></tr>
  </thead>
  <tbody>
    <% definitions.forEach(f => { %>
    <tr>
      <td><%= f.name %></td>
      <td><code><%= f.slug %></code></td>
      <td><%= f.total %></td>
      <td><%= f.last_submission ? new Date(f.last_submission).toLocaleString('it-IT') : '—' %></td>
      <td style="white-space:nowrap;">
        <a href="/admin/forms/<%= f.slug %>/edit?site_id=<%= siteId %>" class="btn btn-sm">Modifica</a>
        <a href="/admin/forms/<%= f.slug %>/submissions?site_id=<%= siteId %>" class="btn btn-sm">Vedi invii</a>
        <button class="btn btn-sm form-copy" style="background:#059669;" data-form-slug="<%= f.slug %>">📋 Copia tag</button>
        <form method="POST" action="/admin/forms/<%= f.slug %>/delete" style="display:inline;"
          class="form-delete-form" data-form-name="<%= f.name %>">
          <input type="hidden" name="site_id" value="<%= siteId %>">
          <button type="submit" class="btn btn-sm btn-danger">Elimina</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<p style="font-size:12px;color:#666;margin-top:8px;">
  Per mostrare un form in una pagina, incolla il suo tag (es. <code>{{form:contatti}}</code>, usa "Copia tag") nel contenuto della pagina.
</p>
<% } %>

<% if (legacyForms.length > 0) { %>
<h2 style="margin-top:32px;font-size:16px;color:#666;">Form scritti a mano nelle pagine</h2>
<p style="font-size:12px;color:#666;">Hanno ricevuto invii ma non sono stati creati con il form builder — non modificabili da qui.</p>
<table>
  <thead>
    <tr><th>Slug form</th><th>Invii totali</th><th>Ultimo invio</th><th></th></tr>
  </thead>
  <tbody>
    <% legacyForms.forEach(f => { %>
    <tr>
      <td><code><%= f.form_slug %></code></td>
      <td><%= f.total %></td>
      <td><%= new Date(f.last_submission).toLocaleString('it-IT') %></td>
      <td><a href="/admin/forms/<%= f.form_slug %>/submissions?site_id=<%= siteId %>" class="btn btn-sm">Vedi invii</a></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.form-copy').forEach(btn => {
    btn.addEventListener('click', function() {
      var tag = '{{form:' + btn.dataset.formSlug + '}}';
      navigator.clipboard.writeText(tag).then(function() {
        var orig = btn.textContent;
        btn.textContent = '✅ Copiato!';
        setTimeout(function() { btn.textContent = orig; }, 2000);
      });
    });
  });
  document.querySelectorAll('.form-delete-form').forEach(form => {
    form.addEventListener('submit', function(event) {
      if (!confirm('Eliminare il form "' + form.dataset.formName + '"? Gli invii già ricevuti restano salvati.')) {
        event.preventDefault();
      }
    });
  });
});
</script>
