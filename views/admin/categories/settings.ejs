<h1><%= t('blogSettings.title') %> — <%= site ? site.name : '' %></h1>

<% if (query && query.saved) { %>
<div class="alert alert-info"><%= t('blogSettings.saved') %></div>
<% } %>

<% if (sites && sites.length > 0) { %>
<form method="GET" style="margin-bottom:15px;display:flex;gap:10px;align-items:flex-end;">
  <div class="form-group" style="margin-bottom:0;">
    <label><%= t('blogSettings.site') %></label>
    <select name="site_id">
      <% sites.forEach(s => { %><option value="<%= s.id %>" <%= selectedSiteId == s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
    </select>
  </div>
  <button type="submit" class="btn"><%= t('blogSettings.changeSite') %></button>
</form>
<% } %>

<form method="POST" action="/admin/blog-settings">
  <input type="hidden" name="site_id" value="<%= site ? site.id : '' %>">
  <div class="form-group">
    <label for="perPage"><%= t('blogSettings.articlesPerPage') %></label>
    <input id="perPage" type="number" name="blog_articles_per_page" min="1" value="<%= config.blog_articles_per_page %>" required>
  </div>
  <div class="form-group">
    <label for="cardTemplate"><%= t('blogSettings.cardTemplate') %></label>
    <p style="font-size:13px;color:#555;margin:5px 0 8px;"><%= t('blogSettings.placeholders') %></p>
    <textarea id="cardTemplate" name="blog_card_template" style="min-height:260px;" required><%= config.blog_card_template %></textarea>
  </div>
  <div class="form-group">
    <label for="articleEmbedTemplate"><%= t('blogSettings.articleEmbedTemplate') %></label>
    <p style="font-size:13px;color:#555;margin:5px 0 8px;"><%= t('blogSettings.articleEmbedPlaceholders') %></p>
    <textarea id="articleEmbedTemplate" name="blog_article_embed_template" style="min-height:200px;"><%= config.blog_article_embed_template %></textarea>
  </div>
  <div class="form-group">
    <label for="indexTitle"><%= t('blogSettings.indexTitle') %></label>
    <input id="indexTitle" type="text" name="blog_index_title" value="<%= config.blog_index_title %>" required>
  </div>
  <div class="form-group">
    <label for="indexIntro"><%= t('blogSettings.indexIntro') %></label>
    <textarea id="indexIntro" name="blog_index_intro_html" style="min-height:160px;"><%= config.blog_index_intro_html %></textarea>
  </div>
  <div class="form-group">
    <label for="homepageCustomCss"><%= t('blogSettings.homepageCustomCss') %></label>
    <textarea id="homepageCustomCss" name="homepage_custom_css" style="min-height:140px;font-family:monospace;"><%= config.homepage_custom_css %></textarea>
  </div>
  <div class="form-group">
    <label for="homepageCustomJs"><%= t('blogSettings.homepageCustomJs') %></label>
    <textarea id="homepageCustomJs" name="homepage_custom_js" style="min-height:140px;font-family:monospace;"><%= config.homepage_custom_js %></textarea>
  </div>
  <div class="form-group"><label for="feedEnabled"><%= t('blogSettings.feedEnabled') %></label>
    <select id="feedEnabled" name="feed_enabled"><option value="0" <%= config.feed_enabled !== '1' ? 'selected' : '' %>><%= t('common.off') %></option><option value="1" <%= config.feed_enabled === '1' ? 'selected' : '' %>><%= t('common.on') %></option></select></div>
  <div class="form-group"><label for="feedLimit"><%= t('blogSettings.feedItemLimit') %></label>
    <input id="feedLimit" type="number" name="feed_item_limit" min="1" max="100" value="<%= config.feed_item_limit %>"></div>
  <div class="form-group"><label for="feedFullContent"><%= t('blogSettings.feedFullContent') %></label>
    <select id="feedFullContent" name="feed_full_content"><option value="0" <%= config.feed_full_content !== '1' ? 'selected' : '' %>><%= t('common.off') %></option><option value="1" <%= config.feed_full_content === '1' ? 'selected' : '' %>><%= t('common.on') %></option></select></div>
  <div class="form-group"><label for="searchEnabled"><%= t('blogSettings.searchEnabled') %></label>
    <select id="searchEnabled" name="search_enabled"><option value="0" <%= config.search_enabled !== '1' ? 'selected' : '' %>><%= t('common.off') %></option><option value="1" <%= config.search_enabled === '1' ? 'selected' : '' %>><%= t('common.on') %></option></select></div>
  <div class="form-group"><label for="searchLang"><%= t('blogSettings.searchLanguage') %></label>
    <select id="searchLang" name="search_language"><% ['italian','english','simple'].forEach(function(l){ %><option value="<%= l %>" <%= config.search_language === l ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
  <div class="form-group"><label for="editorialEnabled"><%= t('blogSettings.editorialEnabled') %></label>
    <select id="editorialEnabled" name="editorial_workflow_enabled"><option value="0" <%= config.editorial_workflow_enabled !== '1' ? 'selected' : '' %>><%= t('common.off') %></option><option value="1" <%= config.editorial_workflow_enabled === '1' ? 'selected' : '' %>><%= t('common.on') %></option></select></div>
  <div class="form-group"><label for="imgMode"><%= t('blogSettings.imagesSrcsetMode') %></label>
    <select id="imgMode" name="images_srcset_mode"><% [['0','common.off'],['srcset','blogSettings.imgModeSrcset'],['picture','blogSettings.imgModePicture']].forEach(function(o){ %><option value="<%= o[0] %>" <%= config.images_srcset_mode === o[0] ? 'selected' : '' %>><%= t(o[1]) %></option><% }) %></select></div>
  <button type="submit" class="btn"><%= t('blogSettings.save') %></button>
  <a href="/admin/categories<%= site ? '?site_id=' + site.id : '' %>" class="btn" style="background:#6b7280;"><%= t('blogSettings.categories') %></a>
</form>
