<h1><%= title %></h1>

<div class="actions">
  <a href="<%= backUrl %>" class="btn" style="background:#6b7280;">← Indietro</a>
</div>

<% if (recipients.length === 0) { %>
  <p style="color:#999;font-size:14px;margin-top:15px;">Nessun invio ancora.</p>
<% } else { %>
<table style="margin-top:15px;">
  <thead>
    <tr><th>Email</th><th>Inviata il</th><th>Aperta</th></tr>
  </thead>
  <tbody>
    <% recipients.forEach(r => { %>
    <tr>
      <td><%= r.email %></td>
      <td style="white-space:nowrap;"><%= new Date(r.sent_at).toLocaleString('it-IT') %></td>
      <td>
        <% if (r.opened_at) { %>
          ✅ <%= new Date(r.opened_at).toLocaleString('it-IT') %> (<%= r.open_count %>×)
        <% } else { %>
          <span style="color:#999;">non aperta</span>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>
