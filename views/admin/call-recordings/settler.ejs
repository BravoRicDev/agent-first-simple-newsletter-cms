<h1>Report settimanale — Provvigioni Setter</h1>
<a href="/admin/call-recordings?site_id=<%= siteId %>">← Torna alle registrazioni</a>

<% if (isSuperadmin && sites.length > 0) { %>
<form method="GET" style="margin:16px 0;display:flex;gap:10px;align-items:flex-end;">
  <div class="form-group" style="margin-bottom:0;">
    <label>Sito</label>
    <select name="site_id" onchange="this.form.submit()">
      <% sites.forEach(s => { %>
        <option value="<%= s.id %>" <%= siteId == s.id ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
  </div>
</form>
<% } %>

<% const cur = report; %>
<div style="display:flex;gap:14px;flex-wrap:wrap;margin:16px 0;">
  <div style="flex:1;min-width:150px;background:#fff;border:1px solid #eef0f4;border-radius:10px;padding:16px;text-align:center;">
    <div style="font-size:12px;color:#6b7280;">Settimana corrente (da <strong><%= new Date(cur.from).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit' }) %></strong>)</div>
    <div style="font-size:28px;font-weight:800;color:#111827;"><%= cur.totale %></div>
    <div style="font-size:12px;color:#6b7280;">totale chiamate</div>
  </div>
  <div style="flex:1;min-width:150px;background:#fff;border:1px solid #eef0f4;border-radius:10px;padding:16px;text-align:center;">
    <div style="font-size:12px;color:#065f46;">✓ Valide</div>
    <div style="font-size:28px;font-weight:800;color:#065f46;"><%= cur.validi %></div>
    <div style="font-size:12px;color:#6b7280;">gettone <%= cur.gettone.toFixed(2).replace('.', ',') %> €</div>
  </div>
  <div style="flex:1;min-width:150px;background:#fff;border:1px solid #eef0f4;border-radius:10px;padding:16px;text-align:center;">
    <div style="font-size:12px;color:#92400e;">? Dubbie</div>
    <div style="font-size:28px;font-weight:800;color:#92400e;"><%= cur.dubbie %></div>
    <div style="font-size:12px;color:#6b7280;">in revisione</div>
  </div>
  <div style="flex:1;min-width:150px;background:#fff;border:1px solid #eef0f4;border-radius:10px;padding:16px;text-align:center;">
    <div style="font-size:12px;color:#991b1b;">✗ Non valide</div>
    <div style="font-size:28px;font-weight:800;color:#991b1b;"><%= cur.non_valide %></div>
    <div style="font-size:12px;color:#6b7280;">non pagabili</div>
  </div>
  <div style="flex:1;min-width:170px;background:#4f46e5;border-radius:10px;padding:16px;text-align:center;color:#fff;">
    <div style="font-size:12px;opacity:.85;">💰 Importo maturato</div>
    <div style="font-size:28px;font-weight:800;"><%= new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(cur.importo_totale) %> / <%= cur.cap %></div>
    <div style="font-size:12px;opacity:.85;"><%= cur.cap_raggiunto ? 'CAP RAGGIUNTO' : ('residuo ' + new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(cur.residuo_cap)) %></div>
  </div>
</div>

<div style="background:#fff;border:1px solid #eef0f4;border-radius:10px;padding:16px;">
  <h3 style="margin-top:0;">Storico settimanale (ultime <%= history.length %> settimane)</h3>
  <table class="table">
    <thead>
      <tr>
        <th>Settimana</th>
        <th>Totale</th>
        <th>Valide</th>
        <th>Dubbie</th>
        <th>Non valide</th>
        <th>Importo (2€/valida)</th>
        <th>Cap</th>
      </tr>
    </thead>
    <tbody>
      <% history.forEach(w => { %>
        <tr>
          <td>dal <%= new Date(w.from).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: 'numeric' }) %></td>
          <td><%= w.totale %></td>
          <td><strong><%= w.validi %></strong></td>
          <td><%= w.dubbie %></td>
          <td><%= w.non_valide %></td>
          <td><%= new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(w.importo_totale) %></td>
          <td><%= w.cap_raggiunto ? '✔ raggiunto' : new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(w.residuo_cap) + ' residuo' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <p style="font-size:12px;color:#6b7280;margin-bottom:0;">
    💡 Il saldo avviene il giovedì. Solo le chiamate <strong>valide</strong> (verdetto <code>si</code> confermato, non scartate) contano per il pagamento.
  </p>
</div>
