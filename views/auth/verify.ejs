<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t('auth.verify.title') %> — <%= app.name %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #1a1a2e; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
    .card { background: #fff; border-radius: 12px; padding: 40px; width: 100%; max-width: 400px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .card h1 { font-size: 22px; margin-bottom: 8px; }
    .card p { color: #666; font-size: 14px; margin-bottom: 20px; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 5px; }
    .form-group input { width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 15px; text-align: center; letter-spacing: 8px; }
    .btn { width: 100%; padding: 12px; background: #4f46e5; color: #fff; border: none; border-radius: 8px; font-size: 15px; cursor: pointer; }
    .btn:hover { background: #4338ca; }
    .msg { text-align: center; font-size: 14px; margin-top: 15px; }
    .error { color: #dc2626; }
  </style>
</head>
<body>
  <div class="card">
    <h1><%= t('auth.verify.title') %></h1>
    <p><%= t('auth.verify.subtitle') %></p>
    <form id="verifyForm">
      <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">
      <input type="hidden" name="redirect_uri" value="<%= typeof redirect_uri !== 'undefined' ? redirect_uri : '' %>">
      <div class="form-group">
        <label><%= t('auth.verify.otp_label') %></label>
        <input type="text" name="otp" required maxlength="6" placeholder="000000" inputmode="numeric" pattern="[0-9]{6}">
      </div>
      <button type="submit" class="btn"><%= t('auth.verify.submit') %></button>
    </form>
    <form id="mfaForm" style="display:none">
      <div class="form-group">
        <label><%= t('auth.mfa.label') %></label>
        <input type="text" name="code" autocomplete="one-time-code" maxlength="24" required>
      </div>
      <button type="submit" class="btn"><%= t('auth.verify.submit') %></button>
      <button type="button" id="passkeyBtn" class="btn" style="display:none;margin-top:8px;background:#0f766e;"><%= t('auth.mfa.usePasskey') %></button>
    </form>
    <input type="hidden" id="ticketInit" value="<%= typeof ticket !== 'undefined' ? ticket : '' %>">
    <div class="msg" id="msg"></div>
  </div>
  <script src="/js/webauthn-client.js"></script>
  <script>
    const i18n = <%- JSON.stringify({
      invalidCodeFallback: t('auth.verify.invalid_code_fallback'),
      requestNewCode: t('auth.verify.request_new_code'),
      connectionError: t('auth.verify.connection_error'),
      mfaInvalid: t('auth.mfa.invalid'),
    }).replace(/</g, '\\u003c') %>;
    let currentTicket = '';
    function showError(text) { const msg = document.getElementById('msg'); msg.textContent = ''; const s = document.createElement('span'); s.className = 'error'; s.textContent = text; msg.appendChild(s); }
    function postJson(url, body) { return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then((r) => r.json()); }
    function showMfa(ticket, methods) {
      currentTicket = ticket;
      document.getElementById('verifyForm').style.display = 'none';
      document.getElementById('mfaForm').style.display = 'block';
      if (methods.indexOf('webauthn') >= 0 && window.cmsWebauthn && window.cmsWebauthn.supported) document.getElementById('passkeyBtn').style.display = 'block';
    }
    document.getElementById('verifyForm').onsubmit = async (e) => {
      e.preventDefault();
      const token = e.target.token.value;
      const otp = e.target.otp.value;
      const redirect_uri = e.target.redirect_uri.value;
      const msg = document.getElementById('msg');
      try {
        const r = await fetch('/api/auth/verify', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, otp, redirect_uri }) });
        const d = await r.json();
        if (d.mfa_required) { showMfa(d.ticket, d.methods || []); return; }
        if (d.user) { location.href = d.redirect_to || '/admin/dashboard'; }
        else {
          const errMsg = d.error || i18n.invalidCodeFallback;
          msg.innerHTML = '<span class="error">' + errMsg +
            (r.status === 401
              ? '<br><a href="/login" style="color:#4f46e5;font-weight:600;display:inline-block;margin-top:8px;">' + i18n.requestNewCode + '</a>'
              : '') + '</span>';
        }
      } catch { msg.innerHTML = '<span class="error">' + i18n.connectionError + '</span>'; }
    };
    document.getElementById('mfaForm').onsubmit = async (e) => {
      e.preventDefault();
      const code = e.target.code.value.trim();
      try {
        const d = await postJson('/api/auth/mfa/verify', /^\d{6}$/.test(code) ? { ticket: currentTicket, totp_code: code } : { ticket: currentTicket, backup_code: code });
        if (d.user) { location.href = d.redirect_to || '/admin/dashboard'; } else { showError(i18n.mfaInvalid); }
      } catch { showError(i18n.connectionError); }
    };
    document.getElementById('passkeyBtn').onclick = async () => {
      try {
        const o = await postJson('/api/auth/mfa/webauthn/options', { ticket: currentTicket });
        if (!o.options) { showError(i18n.mfaInvalid); return; }
        const response = await window.cmsWebauthn.get(o.options);
        const d = await postJson('/api/auth/mfa/webauthn/verify', { ticket: currentTicket, challenge_id: o.challenge_id, response });
        if (d.user) { location.href = d.redirect_to || '/admin/dashboard'; } else { showError(i18n.mfaInvalid); }
      } catch { showError(i18n.mfaInvalid); }
    };
    const initTicket = document.getElementById('ticketInit').value;
    if (initTicket) showMfa(initTicket, ['totp', 'backup', 'webauthn']);
  </script>
</body>
</html>
