<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t('auth.login.title') %> — <%= app.name %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #1a1a2e; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
    .card { background: #fff; border-radius: 12px; padding: 40px; width: 100%; max-width: 400px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .card h1 { font-size: 22px; margin-bottom: 8px; }
    .card p { color: #666; font-size: 14px; margin-bottom: 20px; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 5px; }
    .form-group input { width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 15px; }
    .btn { width: 100%; padding: 12px; background: #4f46e5; color: #fff; border: none; border-radius: 8px; font-size: 15px; cursor: pointer; }
    .btn:hover { background: #4338ca; }
    .msg { text-align: center; font-size: 14px; margin-top: 15px; }
    .sso-link { display: block; text-align: center; padding: 10px; margin-top: 8px; border: 1px solid #ddd; border-radius: 8px; color: #111; text-decoration: none; font-size: 14px; }
  </style>
</head>
<body>
  <div class="card">
    <h1><%= t('auth.login.title') %></h1>
    <p><%= t('auth.login.subtitle') %></p>
    <form id="loginForm">
      <input type="hidden" name="redirect_uri" value="<%= typeof redirect_uri !== 'undefined' ? redirect_uri : '' %>">
      <div class="form-group">
        <label><%= t('auth.login.email_label') %></label>
        <input type="email" name="email" required placeholder="tua@email.com">
      </div>
      <button type="submit" class="btn"><%= t('auth.login.submit') %></button>
    </form>
    <div class="msg" id="msg"></div>
    <div id="ssoBox" style="margin-top:16px;display:none;"></div>
    <button type="button" id="passkeyLogin" class="btn" style="display:none;margin-top:12px;background:#0f766e;"><%= t('auth.mfa.passkeyLogin') %></button>
  </div>
  <script src="/js/webauthn-client.js"></script>
  <script>
    const i18n = <%- JSON.stringify({
      sending: t('auth.login.sending'),
      checkEmailFallback: t('auth.login.check_email_fallback'),
      connectionError: t('auth.login.connection_error'),
      ssoWith: t('auth.mfa.ssoWith'),
      errors: {
        oidc_failed: t('auth.error.oidc_failed'), state_mismatch: t('auth.error.state_mismatch'), nonce_mismatch: t('auth.error.nonce_mismatch'),
        email_not_verified: t('auth.error.email_not_verified'), domain_not_allowed: t('auth.error.domain_not_allowed'),
        no_local_user: t('auth.error.no_local_user'), user_disabled: t('auth.error.user_disabled'), site_mismatch: t('auth.error.site_mismatch'),
      },
    }).replace(/</g, '\\u003c') %>;
    document.getElementById('loginForm').onsubmit = async (e) => {
      e.preventDefault();
      const email = e.target.email.value;
      const msg = document.getElementById('msg');
      msg.textContent = i18n.sending;
      try {
        const r = await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
        const d = await r.json();
        msg.textContent = d.message || i18n.checkEmailFallback;
      } catch { msg.textContent = i18n.connectionError; }
    };
    (function () {
      const redirectUri = document.querySelector('#loginForm input[name=redirect_uri]').value;
      const errKey = new URLSearchParams(location.search).get('error');
      if (errKey && Object.prototype.hasOwnProperty.call(i18n.errors, errKey)) document.getElementById('msg').textContent = i18n.errors[errKey];
      fetch('/auth/oidc/providers', { credentials: 'same-origin' }).then((r) => r.json()).then((d) => {
        const box = document.getElementById('ssoBox');
        (d.providers || []).forEach((p) => {
          const a = document.createElement('a');
          a.className = 'sso-link';
          a.href = '/auth/oidc/' + encodeURIComponent(p.id) + '/start' + (redirectUri ? '?redirect_uri=' + encodeURIComponent(redirectUri) : '');
          a.textContent = i18n.ssoWith + ' ' + p.name;
          box.appendChild(a);
        });
        if (box.children.length) box.style.display = 'block';
      }).catch(() => {});
      if (window.cmsWebauthn && window.cmsWebauthn.supported) {
        const b = document.getElementById('passkeyLogin');
        b.style.display = 'block';
        b.onclick = async () => {
          try {
            const o = await fetch('/api/auth/passkey/options', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).then((r) => r.json());
            const response = await window.cmsWebauthn.get(o.options);
            const d = await fetch('/api/auth/passkey/verify', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ challenge_id: o.challenge_id, response, redirect_uri: redirectUri }) }).then((r) => r.json());
            if (d.user) location.href = d.redirect_to || '/admin/dashboard';
            else document.getElementById('msg').textContent = i18n.connectionError;
          } catch { document.getElementById('msg').textContent = i18n.connectionError; }
        };
      }
    })();
  </script>
</body>
</html>
