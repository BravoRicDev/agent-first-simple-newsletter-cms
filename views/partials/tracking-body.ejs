<%
  // Il banner nativo CMS si renderizza solo se il sito non ha delegato il
  // consenso a un provider esterno (settings tracking_consent_provider).
  // Vuoto/"native" = comportamento attuale, zero regressioni sui siti che
  // non toccano questa chiave.
  const _consentProvider = (typeof consentProvider !== 'undefined' && consentProvider) || 'native';

  // JSON sicuro dentro <script>: JSON.stringify NON scappa "</script>" e un
  // valore configurabile (es. consentScriptUrl, leadEventName) contenente
  // "</script><script>..." verrebbe eseguito su ogni pagina pubblica.
  // Sostituire "<" con "\u003c" rende innocua qualunque chiusura di tag
  // (fix XSS persistente tracking, cross-sito e static-export).
  const _jsonScript = (v) => JSON.stringify(v).replace(/</g, '\\u003c');
%>
<% if (typeof hasAnyTracking !== 'undefined' && hasAnyTracking && _consentProvider === 'native') { %>
<div id="cms-consent-banner" style="display:none;position:fixed;bottom:0;left:0;right:0;background:#1f2937;color:#f3f4f6;padding:16px 20px;padding-bottom:calc(16px + env(safe-area-inset-bottom, 0px));font-size:13px;z-index:9999;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;">
  <span style="flex:1;min-width:200px;">
    <%= consentBannerText %>
    <% if (typeof consentPrivacyUrl !== 'undefined' && consentPrivacyUrl) { %>
    <a href="<%= consentPrivacyUrl %>" style="color:#93c5fd;text-decoration:underline;">Scopri di più</a>
    <% } %>
  </span>
  <span style="display:flex;gap:8px;flex-wrap:wrap;">
    <button type="button" id="cms-consent-reject" style="background:transparent;color:#f3f4f6;border:1px solid #6b7280;border-radius:6px;padding:8px 14px;font-size:13px;cursor:pointer;"><%= consentRejectLabel %></button>
    <button type="button" id="cms-consent-accept" style="background:#4f46e5;color:#fff;border:none;border-radius:6px;padding:8px 14px;font-size:13px;cursor:pointer;"><%= consentAcceptLabel %></button>
  </span>
</div>
<script>
(function () {
  // trackPageview: override per-pagina (true/false/null). null = eredita da sito (default: traccia PageView su consenso marketing).
  var TRACK_PAGEVIEW = <%- _jsonScript(typeof trackPageview !== 'undefined' ? trackPageview : null) %>;
  function getCookie(name) {
    var m = document.cookie.match('(?:^|; )' + name + '=([^;]*)');
    return m ? decodeURIComponent(m[1]) : null;
  }
  function cookieDomain() {
    var h = location.hostname;
    // localhost / IP: cookie host-only (Domain non valido né necessario)
    if (!h || h === 'localhost' || /^[\d.]+$/.test(h)) return null;
    var parts = h.split('.');
    // Copre TUTTI i sottodomini del registrable domain (ultime 2 label).
    if (parts.length >= 2) return '.' + parts.slice(-2).join('.');
    return null;
  }
  function setCookie(name, value, days) {
    var expires = new Date(Date.now() + days * 86400000).toUTCString();
    // Secure solo su HTTPS: il consenso non deve viaggiare in chiaro su HTTP
    var secure = location.protocol === 'https:' ? '; Secure' : '';
    var domain = cookieDomain();
    // Senza Domain il cookie è host-only: su funnel serviti su host/sottodomini
    // diversi il consenso impostato su una pagina non era leggibile dalle
    // altre (cookie marketing mai fired oltre la pagina di accettazione).
    document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + expires + '; path=/; SameSite=Lax'
                      + (domain ? '; Domain=' + domain : '') + secure;
  }
  function applyConsent(analytics, marketing) {
    gtag('consent', 'update', {
      'analytics_storage': analytics ? 'granted' : 'denied',
      'ad_storage': marketing ? 'granted' : 'denied',
      'ad_user_data': marketing ? 'granted' : 'denied',
      'ad_personalization': marketing ? 'granted' : 'denied'
    });
    // Meta Pixel: il base code è già nell'head (init + consent revoke di
    // default). Qui, a consenso marketing concesso, sblocchiamo il pixel e
    // inviamo PageView + un segnale globale (cms:marketing-granted) a cui gli
    // script di conversione nella pagina (Lead, CompleteRegistration, ...)
    // sono in ascolto per partire solo DOPO il consenso.
    // trackPageview === false (override per-pagina): non chiamare fbq('track','PageView')
    // ma fbq('consent','grant') serve comunque per eventuali altri eventi custom.
    if (marketing) {
      window.__cmsMarketingGranted = true;
      if (window.fbq && typeof window.fbq === 'function') {
        fbq('consent', 'grant');
        if (TRACK_PAGEVIEW !== false) {
          fbq('track', 'PageView');
        }
      }
      try { window.dispatchEvent(new Event('cms:marketing-granted')); } catch (e) {}
    } else if (window.fbq && typeof window.fbq === 'function') {
      fbq('consent', 'revoke');
    }
    <% if (typeof clarityId !== 'undefined' && clarityId) { %>
    if (analytics && !window.clarity) {
      (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","<%= clarityId %>");
    }
    <% } %>
  }

  var banner = document.getElementById('cms-consent-banner');
  var storedAnalytics = getCookie('consent_analytics');
  var storedMarketing = getCookie('consent_marketing');

  if (storedAnalytics !== null) {
    applyConsent(storedAnalytics === '1', storedMarketing === '1');
  } else {
    banner.style.display = 'flex';
  }

  document.getElementById('cms-consent-accept').addEventListener('click', function () {
    setCookie('consent_analytics', '1', 365);
    setCookie('consent_marketing', '1', 365);
    applyConsent(true, true);
    banner.style.display = 'none';
  });
  document.getElementById('cms-consent-reject').addEventListener('click', function () {
    setCookie('consent_analytics', '0', 365);
    setCookie('consent_marketing', '0', 365);
    applyConsent(false, false);
    banner.style.display = 'none';
  });
})();
</script>
<% } %>
<% if (_consentProvider === 'external' && typeof consentLibUrl !== 'undefined' && consentLibUrl && typeof consentScriptUrl !== 'undefined' && consentScriptUrl) { %>
<!-- Provider di consenso esterno (settings tracking_consent_provider=external):
     il banner nativo sopra NON è renderizzato. Il CMS si limita a caricare gli
     asset configurati (tipicamente vendored per-sito in media/<site>/consent/,
     bind-mount — sopravvivono ai rebuild) e delega l'inizializzazione allo
     script esterno. CONTRATTO: lo script esterno deve scrivere gli stessi
     cookie letti dal resto del CMS — consent_analytics / consent_marketing
     ("1"/"0") — e chiamare gtag('consent','update',...) / fbq('consent',
     'grant'|'revoke') coerentemente, altrimenti CAPI/pixel/Lead automatico
     qui sotto restano ciechi sul consenso reale. -->
<script>
(function () {
  <% if (typeof consentLibCssUrl !== 'undefined' && consentLibCssUrl) { %>
  var l = document.createElement('link');
  l.rel = 'stylesheet';
  l.href = <%- _jsonScript(consentLibCssUrl) %>;
  document.head.appendChild(l);
  <% } %>
  var a = document.createElement('script');
  a.src = <%- _jsonScript(consentLibUrl) %>;
  a.onload = function () {
    var b = document.createElement('script');
    b.src = <%- _jsonScript(consentScriptUrl) %>;
    document.head.appendChild(b);
  };
  // Fail-safe: se la lib esterna non carica, nessun banner viene mostrato e
  // il consenso resta negato di default (fbq('consent','revoke') dell'head
  // non viene mai sbloccato) — nessun tracciamento indesiderato.
  a.onerror = function () {};
  document.head.appendChild(a);
})();
</script>
<% } %>
<% if (typeof leadEventName !== 'undefined' && leadEventName && typeof leadPages !== 'undefined' && leadPages) { %>
<!-- Evento "<%= leadEventName %>" lato browser su pagine di conversione senza
     submit gestito dal CMS (form esterni: il CAPI server-side in
     forms.js/quizzes.js/newsletter.js non scatta mai per questi lead).
     Gated SEMPRE sul consenso marketing (Consent Mode v2, sia banner nativo
     che esterno scrivono lo stesso cookie consent_marketing), una volta per
     sessione per evitare doppi conteggi su refresh. Pagine e nome evento
     configurabili via settings (tracking_lead_pages / tracking_lead_event);
     vuoto = disattivato, nessuna regressione.
     leadOverride per-pagina: true = forza Lead anche se path non matcha leadPages;
     false = non sparare MAI Lead su questa pagina anche se path matcha leadPages;
     null/undefined = usa logica standard leadPages (default). -->
<script>
(function () {
  var EVENT_NAME = <%- _jsonScript(leadEventName) %>;
  var PAGES = <%- _jsonScript(leadPages.split(',').map(function (s) { return s.trim(); }).filter(Boolean)) %>;
  var LEAD_OVERRIDE = <%- _jsonScript(typeof leadOverride !== 'undefined' ? leadOverride : null) %>;
  var FLAG_KEY = 'cms_lead_fired_' + EVENT_NAME;

  function getCookie(name) {
    var m = document.cookie.match('(?:^|; )' + name + '=([^;]*)');
    return m ? decodeURIComponent(m[1]) : null;
  }
  function matchesPage() {
    var target = (location.pathname + location.search).toLowerCase();
    for (var i = 0; i < PAGES.length; i++) {
      if (PAGES[i] && target.indexOf(PAGES[i].toLowerCase()) > -1) return true;
    }
    return false;
  }
  function shouldFireLead() {
    // leadOverride === true: forza sempre (bypass matchPage)
    if (LEAD_OVERRIDE === true) return true;
    // leadOverride === false: non sparare mai
    if (LEAD_OVERRIDE === false) return false;
    // altrimenti: usa logica standard matchPage
    return matchesPage();
  }
  function fireOnce() {
    if (!shouldFireLead()) return;
    try { if (sessionStorage.getItem(FLAG_KEY)) return; } catch (e) {}
    if (getCookie('consent_marketing') !== '1') return;
    if (!(window.fbq && typeof window.fbq === 'function')) return;
    try { sessionStorage.setItem(FLAG_KEY, '1'); } catch (e) {}
    fbq('track', EVENT_NAME);
    // Diagnostica: verifica in DevTools che il Lead sia partito davvero
    // (digitare `leadFlag` in console → "1") senza dover riaprire il Pixel
    // Helper. Puramente additiva, non cambia il comportamento di tracking.
    try { window.leadFlag = '1'; console.log('[Lead] ✓', EVENT_NAME, '→', location.pathname); } catch (e) {}
  }

  // Consenso già presente al caricamento (visitatore di ritorno, o provider
  // esterno che ha già scritto il cookie prima che questo script giri).
  fireOnce();
  // Consenso concesso durante QUESTA visita (banner nativo o esterno, se lo
  // implementa: vedi contratto sopra) → 'cms:marketing-granted'.
  window.addEventListener('cms:marketing-granted', fireOnce);
})();
</script>
<% } %>
