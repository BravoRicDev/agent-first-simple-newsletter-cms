<% if (typeof searchConsoleVerification !== 'undefined' && searchConsoleVerification) { %>
<meta name="google-site-verification" content="<%= searchConsoleVerification %>">
<% } %>

<% if (typeof hasAnyTracking !== 'undefined' && hasAnyTracking) { %>
<!-- Consent Mode v2: default negato, aggiornato dal banner sotto. Deve
     essere impostato PRIMA che GTM/gtag/pixel vengano caricati. -->
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
gtag('consent', 'default', {
  'ad_storage': 'denied',
  'analytics_storage': 'denied',
  'ad_user_data': 'denied',
  'ad_personalization': 'denied',
  'wait_for_update': 500
});
</script>

<% if (typeof gtmId !== 'undefined' && gtmId) { %>
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%= gtmId %>');</script>
<% } %>

<% if (typeof ga4Id !== 'undefined' && ga4Id) { %>
<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga4Id %>"></script>
<script>gtag('js', new Date()); gtag('config', '<%= ga4Id %>');</script>
<% } %>

<% if (typeof metaPixelId !== 'undefined' && metaPixelId && pixelEnabled !== false) { %>
<!-- Meta Pixel: caricato SEMPRE nel <head> (così Events Manager / Pixel
     Helper rilevano il codice base), ma con consenso marketing REVOCATO di
     default (Consent Mode v2). PageView ed eventi conversione (Lead,
     CompleteRegistration, ...) partono SOLO dopo che l'utente accetta il
     marketing nel banner: vedi tracking-body.ejs (applyConsent).
     pixelEnabled === false (override per-pagina) salta completamente l'init. -->
<script>
!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
// Dedup PageView a livello di fbq stesso, indipendente da CHI lo chiama:
// il CMS (applyConsent, guardia window.__cmsPageViewFired) o un bridge di
// consenso esterno/vendored per-sito (media/<site>/consent/bridge.js) che
// non riusa window.__cmsApplyConsent e riapplica il consenso da solo.
// Senza questa rete di sicurezza, un bridge vendored "vecchio stile" può
// rifare fbq('track','PageView') sulla stessa pagina, duplicando le
// conversioni in Meta. Con questa guardia, chiunque chiami per primo vince
// e i chiamanti successivi nello stesso page-load vengono ignorati.
// NB: usa un flag TUTTO SUO (__fbqPageViewSent), diverso da
// window.__cmsPageViewFired: quest'ultimo viene impostato dal CMS PRIMA di
// chiamare fbq(...), quindi se il wrapper leggesse lo stesso flag lo
// troverebbe già a true e scarterebbe anche il primissimo invio legittimo
// (bug verificato e corretto durante lo sviluppo di questa guardia).
(function () {
  var _fbqStub = window.fbq;
  window.fbq = function (action, name) {
    if (action === 'track' && name === 'PageView') {
      if (window.__fbqPageViewSent) return;
      window.__fbqPageViewSent = true;
    }
    return _fbqStub.apply(this, arguments);
  };
  for (var k in _fbqStub) {
    if (Object.prototype.hasOwnProperty.call(_fbqStub, k)) window.fbq[k] = _fbqStub[k];
  }
})();
fbq('init', '<%= metaPixelId %>');
fbq('consent', 'revoke');
window.__cmsMarketingGranted = false;
</script>
<noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=<%= metaPixelId %>&ev=PageView&noscript=1"/></noscript>
<% } %>
<% } %>
